{
  "name": "@boundry/intel-registry",
  "version": "0.1.0",
  "private": true,
  "description": "Boundry Intel: product, product version, repository, capability and integration identities with provenance, authenticated publisher identities, and durable acceptance of boundry.event/1 envelopes, stored on FeltDB.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./src/index.mjs",
